#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

npx lint-staged

# Constitution VIII: no em dash, en dash, ellipsis character or arrow in added lines.
# Byte patterns under LC_ALL=C so the check does not depend on the caller's locale.
if git diff --cached -U0 | LC_ALL=C grep -P '^\+(?!\+\+ ).*(\xE2\x80[\x93\x94\xA6]|\xE2\x86\x92)'; then
  echo "Constitution VIII: replace the em/en dash, ellipsis character or arrow above." >&2
  exit 1
fi
